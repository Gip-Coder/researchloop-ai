# =====================================================================
# researchloop-ai — Shared Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# Member 1: AI / Agent Engine Configuration
# ---------------------------------------------------------------------

# Operational Mode:
# 'mock' = Complete offline execution with deterministic fixtures (no keys needed)
# 'live' = Connect to real LLMs and academic provider APIs
RESEARCHLOOP_MODE=live

# Active LLM Provider: 'mock' | 'openai' | 'anthropic' | 'gemini' | 'ollama'
LLM_PROVIDER=ollama

# Model Overrides (optional, defaults to provider standard if omitted)
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MODEL=gemini-3.8-flash
# LLM_MODEL=llama3.2:3b

# Ollama local server (no API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud LLM API credentials (Ollama runs locally and needs no key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Academic Search Credentials & Preferred Sources
# Academic retrieval providers in preferred order (default: arxiv,crossref)
# Semantic Scholar is excluded by default to eliminate rate-limit errors and reduce latency.
# To enable Semantic Scholar, set: PREFERRED_SOURCES=arxiv,crossref,semantic_scholar
PREFERRED_SOURCES=arxiv,crossref
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=researcher@example.com

# Engine Hyperparameters
DEFAULT_MAX_ITERATIONS=3
DEFAULT_TARGET_COVERAGE=0.85
DEFAULT_MIN_NEW_PAPERS=1
ACADEMIC_REQUEST_TIMEOUT=15.0
ACADEMIC_MAX_RETRIES=3
RESEARCH_CACHE_ENABLED=true
CACHE_DIR=.cache/researchloop

# Research Quality & Literature Selection Policy
MIN_PUBLICATION_YEAR=2019
PREFERRED_MIN_CITATIONS=10
PREFERRED_MAX_CITATIONS=15
STRICT_CITATION_FILTERING=false
MIN_SYNTHESIS_PAPERS=6
TARGET_SYNTHESIS_PAPERS=8
MAX_SYNTHESIS_PAPERS=10
ALLOW_FOUNDATIONAL_EXCEPTIONS=false

# Testing: Set to 1 to enable live provider smoke tests (requires API keys & network)
RUN_LIVE_API_TESTS=0

# ---------------------------------------------------------------------
# Member 2: API, Database & Application Services
# ---------------------------------------------------------------------
# Database connection string (defaults to local SQLite for zero-credential offline execution)
DATABASE_URL=sqlite+aiosqlite:///./researchloop.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchloop

# Application security & CORS
SECRET_KEY=change-me-to-a-secure-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend integration
FRONTEND_PORT=5173
BACKEND_PORT=8000
